{
  "mcpServers": {
    "conscios-self-model": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/self-model-mcp.mjs"
      ],
      "env": {
        "CONSCIOS_SELF_MODEL_DIR": "artifacts/self-model/current"
      }
    },
    "conscios-development-landscape": {
      "type": "stdio",
      "command": "node",
      "args": [
        "scripts/development-landscape-mcp.mjs"
      ],
      "env": {
        "CONSCIOS_DEVELOPMENT_LANDSCAPE": "artifacts/development-landscape/current.json"
      }
    }
  }
}
