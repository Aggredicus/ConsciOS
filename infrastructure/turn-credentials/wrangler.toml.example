name = "conscios-turn-credentials"
main = "worker.mjs"
compatibility_date = "2026-09-01"

[vars]
ALLOWED_ORIGINS = "https://aggredicus.github.io"
TURN_URLS = "turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp"
TURN_TTL_SECONDS = "600"

# Set TURN_SHARED_SECRET as an encrypted Worker secret, never in this file:
#   npx wrangler secret put TURN_SHARED_SECRET
