# ConsciOS coturn template
# Replace placeholders before deployment. Do not commit the real shared secret.

listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_LONG_RANDOM_SECRET
realm=turn.example.com
server-name=turn.example.com

# TLS is strongly recommended for TURN over TLS.
cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem

# Bounded credential lifetime is enforced by the timestamped TURN REST username.
stale-nonce=600

# Operational hardening.
no-cli
no-loopback-peers
no-multicast-peers
no-tcp-relay
user-quota=12
total-quota=1200
max-bps=100000000

# Relay range: open the same UDP range in the host firewall/security group.
min-port=49160
max-port=49260

# Recommended logging defaults. Avoid verbose logs in normal operation.
simple-log
log-file=stdout

# If the TURN host is behind NAT, configure external-ip as required by coturn:
# external-ip=PUBLIC_IP/PRIVATE_IP
