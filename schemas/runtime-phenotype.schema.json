{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conscios.dev/schemas/runtime-phenotype.schema.json",
  "title": "ConsciOS Compiled Runtime Phenotype v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "programId", "programVersion", "mode", "phenotypeHash", "activeRoles", "domains", "edges", "payloadSchemas", "capabilityContexts", "providerPermissions", "budgets", "causalAuthority"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "programId": {"type": "string", "minLength": 1},
    "programVersion": {"type": "integer", "minimum": 1},
    "mode": {"const": "shadow"},
    "phenotypeHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "activeRoles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "edges": {"type": "array", "items": {"type": "object"}},
    "payloadSchemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilityContexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "providerPermissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budgets": {"type": "object"},
    "causalAuthority": {"const": "none"}
  }
}
