{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conscios.dev/schemas/regulatory-program.schema.json",
  "title": "ConsciOS Cortical Ecology Regulatory Program v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "programId", "programVersion", "mode", "phases", "domains", "roles", "edges", "payloadSchemas", "capabilityContexts", "providerPermissions", "budgets"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "programId": {"type": "string", "minLength": 1},
    "programVersion": {"type": "integer", "minimum": 1},
    "mode": {"const": "shadow"},
    "description": {"type": "string"},
    "phases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["online", "consolidation", "maintenance", "recovery"]}},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "domain", "sourceAliases", "allowedEpistemicStatuses"],
        "properties": {
          "role": {"type": "string", "minLength": 1},
          "domain": {"type": "string", "minLength": 1},
          "sourceAliases": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "allowedEpistemicStatuses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["observation", "inference", "prediction", "memory", "counterfactual", "action", "expression", "governance"]}}
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceRole", "targetDomain", "kind"],
        "properties": {
          "sourceRole": {"type": "string", "minLength": 1},
          "targetDomain": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1}
        }
      }
    },
    "payloadSchemas": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "capabilityContexts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "providerPermissions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workspaceCapacity", "maxEnvelopeTtlCycles", "maxEnvelopeBytes", "maxRecurrentStateBytes"],
      "properties": {
        "workspaceCapacity": {"type": "integer", "minimum": 1},
        "maxEnvelopeTtlCycles": {"type": "integer", "minimum": 1},
        "maxEnvelopeBytes": {"type": "integer", "minimum": 256},
        "maxRecurrentStateBytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
