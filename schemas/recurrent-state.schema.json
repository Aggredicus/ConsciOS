{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://conscios.local/schemas/recurrent-state.schema.json",
  "title":"ConsciOS Recurrent State v1.4",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","cycleId","worldSummary","selfSummary","predictions","executiveActionId","homeostasisStatus","anchorEventId"],
  "properties":{
    "schemaVersion":{"const":"1.4.0"},
    "cycleId":{"type":"integer","minimum":1},
    "worldSummary":{
      "type":"object","additionalProperties":false,
      "required":["runtimeChangeObserved","updateMode"],
      "properties":{"runtimeChangeObserved":{"type":["boolean","null"]},"updateMode":{"type":"string"}}
    },
    "selfSummary":{
      "type":"object","additionalProperties":false,
      "required":["recurrentContextUsed","priorCycleId"],
      "properties":{"recurrentContextUsed":{"type":"boolean"},"priorCycleId":{"type":["integer","null"]}}
    },
    "predictions":{
      "type":"object","additionalProperties":false,
      "required":["runtimeIncreaseProbability","confidence"],
      "properties":{"runtimeIncreaseProbability":{"type":"number","minimum":0,"maximum":1},"confidence":{"type":"number","minimum":0,"maximum":1}}
    },
    "executiveActionId":{"type":"string","minLength":1},
    "homeostasisStatus":{"enum":["stable","attention-required","degraded"]},
    "anchorEventId":{"type":"string","minLength":1}
  }
}
