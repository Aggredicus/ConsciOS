{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://conscios.example/schemas/development-landscape.schema.json",
  "title": "ConsciOS Development Landscape v0.1",
  "type": "object",
  "required": [
    "version",
    "kind",
    "landscapeId",
    "source",
    "capabilityProfiles",
    "repositories",
    "nodes",
    "edges",
    "landscapeHash"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "conscios-development-landscape"
    },
    "generatedAt": {
      "type": "string"
    },
    "landscapeId": {
      "type": "string",
      "minLength": 1
    },
    "landscapeHash": {
      "type": "string",
      "minLength": 32
    },
    "source": {
      "type": "object",
      "required": [
        "globalCommitCap",
        "totalCommits",
        "includedCommits",
        "truncated",
        "allocationPolicy"
      ],
      "additionalProperties": true
    },
    "capabilityProfiles": {
      "type": "object"
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "role",
          "commitCount",
          "includedCommits",
          "truncated",
          "historyComplete"
        ],
        "additionalProperties": true
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "type",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "repo": {
          "type": [
            "string",
            "null"
          ]
        },
        "timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "w": {
          "type": [
            "number",
            "null"
          ]
        },
        "properties": {
          "type": "object"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "type",
        "source",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "properties": {
          "type": "object"
        },
        "provenance": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
