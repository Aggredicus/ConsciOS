{
  "name": "ConsciOS Inverse Conway Development Lab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "8gb",
    "storage": "16gb"
  },
  "forwardPorts": [
    8000,
    8888
  ],
  "portsAttributes": {
    "8000": {
      "label": "ConsciOS browser lab",
      "onAutoForward": "notify"
    },
    "8888": {
      "label": "Optional JupyterLab",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "remoteEnv": {
    "CONSCIOS_DEV_ENV": "devcontainer"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.formatOnSave": false
      }
    }
  }
}
